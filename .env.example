# Copy to .env and fill in real values. NEVER commit .env.
# Streamlit Cloud: put these keys under Settings -> Secrets instead.

# Optional: live football-data.org API key (free tier: 10 requests/minute).
# Used by the optional live adapter. The app runs fully in demo mode without it.
FOOTBALL_DATA_API_KEY=

# Optional: OpenAI-compatible API for AI-generated prose. The system works
# without it (AI wording is optional and clearly labelled when used).
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=